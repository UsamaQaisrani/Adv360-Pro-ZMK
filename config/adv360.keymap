#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        // Hold = momentary layer, tap = toggle layer (tap behaves like the old &tog)
        mo_tog: mo_tog {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "hold-preferred";
            bindings = <&mo>, <&tog>;
        };

        // tmux: sends prefix (C-a) then the given key, e.g. &tmux H
        tmux: tmux {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&kp LC(A)>, <&macro_param_1to1>, <&kp MACRO_PLACEHOLDER>;
        };

        // harpoon: sends Space (nvim leader) then the given key, e.g. &harpoon N1
        harpoon: harpoon {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&kp SPACE>, <&macro_param_1to1>, <&kp MACRO_PLACEHOLDER>;
        };

        // AeroSpace workspaces: tap = ctrl-N (go to workspace), shift+tap = cmd-shift-N (move window there)
        ws1: ws1 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LC(N1)>, <&kp LG(LS(N1))>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        ws2: ws2 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LC(N2)>, <&kp LG(LS(N2))>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        ws3: ws3 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LC(N3)>, <&kp LG(LS(N3))>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        ws4: ws4 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LC(N4)>, <&kp LG(LS(N4))>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        ws5: ws5 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LC(N5)>, <&kp LG(LS(N5))>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        ws6: ws6 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LC(N6)>, <&kp LG(LS(N6))>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        ws7: ws7 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LC(N7)>, <&kp LG(LS(N7))>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1        &kp N2    &kp N3    &kp N4     &kp N5  &tog 1                                                                    &mo 3     &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q         &kp W     &kp E     &kp R      &kp T   &none                                                                     &none     &kp Y   &kp U   &kp I      &kp O     &kp P     &kp BSLH
&kp ESC    &kp A         &kp S     &kp D     &kp F      &kp G   &mo 5      &kp GRAVE  &kp ESCAPE             &kp PAGE_UP       &kp RCTRL  &mo 6     &kp H   &kp J   &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z         &kp X     &kp C     &kp V      &kp B                         &kp LEFT_CONTROL       &mo_tog 4 4                                 &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&mo 2      &kp LEFT_ALT  &kp CAPS  &kp LEFT  &kp RIGHT          &kp SPACE  &kp ENTER  &kp RIGHT_COMMAND      &kp LEFT_COMMAND  &kp DEL    &kp BSPC          &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &mo 2
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                                   &mo 3      &kp N6  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                    &none      &kp Y   &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp H   &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp HOME      &kp PG_UP                        &kp N   &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&mo 2      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp KP_N0          &kp UP      &kp DOWN      &kp KP_DOT     &kp RBKT         &mo 2
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2      &kp F3       &kp F4     &kp F5  &kp F6  &tog 1                                      &mo 3   &kp F7    &kp F8     &kp F9    &kp F10    &kp F11  &kp F12
&trans  &kp C_PREV  &kp C_PP     &kp C_NEXT &trans  &trans  &none                                       &none   &kp HOME  &kp PG_DN  &kp PG_UP &kp END    &trans   &trans
&trans  &kp C_VOL_DN &kp C_VOL_UP &kp C_MUTE &trans &trans  &none   &trans  &trans      &trans  &trans  &none   &kp LEFT  &kp DOWN   &kp UP    &kp RIGHT  &trans   &trans
&trans  &kp C_BRI_DN &kp C_BRI_UP &trans    &trans  &trans                  &trans      &trans                  &trans    &trans     &trans    &trans     &trans   &trans
&trans  &trans      &trans       &trans     &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans     &trans    &trans     &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        extra1 {
            display-name = "Desktop";
            bindings = <
&none   &ws1    &ws2        &ws3            &ws4            &ws5    &trans                                  &trans  &ws6    &ws7            &none   &none   &none           &none
&trans  &none   &none       &kp LA(LS(E))   &kp LG(LS(R))   &none   &none                                   &none   &none   &none           &none   &none   &kp LG(LS(P))   &none
&trans  &none   &kp LA(S)   &none           &none           &kp LA(G) &none  &trans  &trans  &trans  &trans  &none   &kp LC(H) &kp LC(J)     &kp LC(K) &kp LC(L) &none        &none
&trans  &none   &none       &none           &none           &none                   &trans  &trans                  &kp LG(LS(N)) &kp LG(LS(M)) &none &none &none          &trans
&trans  &trans  &trans      &trans          &trans                  &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans          &trans  &trans          &trans
            >;
        };

        extra2 {
            display-name = "Tmux";
            bindings = <
&none   &none   &none   &none   &none   &none   &trans                                  &trans  &none       &none       &none       &none       &none       &tmux MINUS
&trans  &none   &none   &none   &none   &none   &none                                   &none   &none       &tmux N1    &tmux N2    &tmux N3    &tmux N4    &tmux BSLH
&trans  &none   &none   &none   &none   &none   &trans  &trans  &trans  &trans  &trans  &none   &tmux H     &tmux J     &tmux K     &tmux L     &tmux F     &none
&trans  &none   &none   &none   &none   &none                   &trans  &trans                  &tmux C     &tmux Z     &none       &none       &tmux LBKT  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans          &trans      &trans      &trans      &trans      &trans
            >;
        };

        extra3 {
            display-name = "Harpoon";
            bindings = <
&none   &none        &none        &none        &none        &none        &trans                                  &trans  &none   &none   &none   &none   &none   &none
&trans  &harpoon N6  &harpoon N7  &harpoon N8  &harpoon N9  &harpoon N0  &none                                   &none   &none   &none   &none   &none   &none   &none
&trans  &harpoon N1  &harpoon N2  &harpoon N3  &harpoon N4  &harpoon N5  &none   &trans  &trans  &trans  &trans  &trans  &none   &none   &none   &none   &none   &none
&trans  &none        &none        &none        &none        &none                        &trans  &trans                  &none   &none   &none   &none   &none   &trans
&trans  &trans       &trans       &trans       &trans                    &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
